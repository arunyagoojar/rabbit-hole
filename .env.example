VITE_AI_PROVIDER=azure-foundry

# Azure AI Foundry / model proxy. Set these in Cloudflare Worker variables/secrets.
AZURE_FOUNDRY_BASE_URL=
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=

# Optional legacy Vite aliases still work for local development.
VITE_AZURE_FOUNDRY_BASE_URL=
VITE_AZURE_FOUNDRY_PROJECT_ENDPOINT=
VITE_AZURE_FOUNDRY_MODEL=
VITE_AZURE_FOUNDRY_API_KEY=

# Image search proxy. Set this in Cloudflare Worker variables/secrets.
PEXELS_API_KEY=

# Optional local browser/dev fallback.
VITE_PEXELS_API_KEY=
VITE_GEMINI_API_KEY=

# Firebase Client & Worker Configuration
FIREBASE_PROJECT_ID=rabbit-hole-944d3
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rabbit-hole-944d3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rabbit-hole-944d3
VITE_FIREBASE_STORAGE_BUCKET=rabbit-hole-944d3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

{
  "name": "rabbit-hole",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./migrations/0001_initial_schema.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_initial_schema.sql",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "lucide-react": "^1.21.0",
    "motion": "^13.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
